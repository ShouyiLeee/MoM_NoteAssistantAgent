            "url": {
              "raw": "{{base_url}}/mock-interview/start",
              "host": ["{{base_url}}"],
              "path": ["mock-interview", "start"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{user_id}}\",\n  \"target_role\": \"ML Engineer\",\n  \"difficulty\": \"medium\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Start a medium-difficulty mock interview for an ML Engineer role. The Simulation Agent uses past weakness patterns to generate a targeted question."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"session_id\": \"uuid-...\",\n  \"question\": {\n    \"question\": \"Design an LRU Cache with O(1) get and put operations.\",\n    \"follow_ups\": [\n      \"What data structures did you choose and why?\",\n      \"Explain the time complexity of each operation.\",\n      \"How would you handle thread safety in a concurrent environment?\"\n    ],\n    \"focus_area\": \"Data Structures & Algorithm Optimization\",\n    \"difficulty\": \"medium\"\n  },\n  \"message\": \"Mock Interview — ML Engineer (Medium)...\"\n}"
            }
          ]
        },
